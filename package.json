{
  "name": "bunny-ui",
  "version": "0.1.8",
  "author": "zhaoyifan",
  "homepage": "https://zhao-yi-fan.github.io/bunny-ui/",
  "private": false,
  "scripts": {
    "serve": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "test:unit": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service test:unit",
    "lib": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --target lib --name bunnyUi ./src/packages/index.js && NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --all --no-clean",
    "docs:install": "npm --prefix docs install",
    "docs:serve": "npm run lib && npm --prefix docs run docs:dev",
    "docs:build": "npm run lib && npm --prefix docs run docs:build",
    "docs:preview": "npm --prefix docs run docs:preview"
  },
  "main": "./dist/bunnyUi.umd.min.js",
  "files": [
    "dist/bunnyUi.common.js",
    "dist/bunnyUi.css",
    "dist/bunnyUi.umd.js",
    "dist/bunnyUi.umd.min.js",
    "dist/lib",
    "dist/css/button",
    "dist/css/button-group",
    "dist/css/dialog",
    "dist/css/divider",
    "dist/css/icon",
    "dist/css/input",
    "dist/css/message",
    "dist/css/tag",
    "dist/css/watermark",
    "README.md"
  ],
  "dependencies": {
    "core-js": "^3.6.5",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "5.0.8",
    "@vue/cli-plugin-unit-mocha": "5.0.8",
    "@vue/cli-service": "5.0.8",
    "@vue/test-utils": "^1.0.3",
    "chai": "^4.1.2",
    "sass": "^1.77.1",
    "sass-loader": "^16.0.5",
    "vue-template-compiler": "^2.7.16"
  }
}
